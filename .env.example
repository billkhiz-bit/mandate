# Copy to .env and fill in. Never commit .env (it is gitignored).

# Claude through the Anthropic API. Leave empty to use the offline sample answers.
ANTHROPIC_API_KEY=
# MANDATE_MODEL=claude-opus-5-5

# PayPal SANDBOX app keys: developer.paypal.com > Apps & Credentials > Sandbox.
# Leave empty to use the offline PayPal stand-in.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional overrides:
# MANDATE_AI=claude | bedrock | offline     (bedrock uses your AWS credentials and AWS_REGION)
# MANDATE_PAYPAL=offline                     (ignore PayPal keys even when set)
